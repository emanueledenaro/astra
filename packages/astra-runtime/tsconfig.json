{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["bun"]
  },
  "include": ["src", "test"],
  "exclude": [
    "src/operation-ledger.ts",
    "src/operation-storage.ts",
    "src/controlled-write-coordinator.ts",
    "src/controlled-write-verifier.ts",
    "src/controlled-write-operation-facts.ts",
    "test/operation-ledger.test.ts",
    "test/controlled-write-coordinator.test.ts"
  ]
}
