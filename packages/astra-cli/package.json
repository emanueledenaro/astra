{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@astra/cli",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "astra": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./app-state": "./src/app-state.ts",
    "./session": "./src/workspace-gate.ts",
    "./terminal": "./src/terminal.ts"
  },
  "scripts": {
    "check:provider-catalog": "bun run ./script/generate-provider-catalog.ts --check --offline-source ../opencode/test/tool/fixtures/models-api.json",
    "demo": "bun run ./src/index.ts open",
    "generate:provider-catalog": "bun run ./script/generate-provider-catalog.ts",
    "refresh:provider-catalog:offline": "bun run ./script/generate-provider-catalog.ts --offline-source ../opencode/test/tool/fixtures/models-api.json",
    "start": "bun run ./src/index.ts",
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "verify:demo": "bun run ./script/verify-demo.ts"
  },
  "dependencies": {
    "@astra/domain": "workspace:*",
    "@astra/git": "workspace:*",
    "@astra/runtime": "workspace:*",
    "@opencode-ai/tui": "workspace:*",
    "opencode": "workspace:*"
  },
  "devDependencies": {
    "@effect/sql-sqlite-bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "effect": "catalog:"
  }
}
